buf_leaf = Buf("COL_THICKET", M_LEAF_DARK)
buf_bark = Buf("COL_TRUNK", M_BARK)
buf_canopy = Buf("CANOPY_TREE", M_CANOPY)      # ★가지는 안 막는다. 밑을 지나가야 한다
buf_moss = Buf("DECO_MOSS", M_MOSS)
buf_stone = Buf("COL_RUIN", M_STONE_PALE)
