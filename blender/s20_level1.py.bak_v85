# 7) 재질
# ─────────────────────────────────────────────────────────────
MATS = {}


def mat_solid(name, hexcol, rough=0.92, backface=True):
    if name in MATS:
        return MATS[name]
    m = bpy.data.materials.new(name)
    m.use_nodes = True
    nt = m.node_tree
    for n in list(nt.nodes):
        nt.nodes.remove(n)
    out = nt.nodes.new("ShaderNodeOutputMaterial")
    bsdf = nt.nodes.new("ShaderNodeBsdfPrincipled")
    bsdf.inputs["Base Color"].default_value = hex_lin(hexcol)
    bsdf.inputs["Roughness"].default_value = rough
    bsdf.inputs["Metallic"].default_value = 0.0
    nt.links.new(bsdf.outputs[0], out.inputs[0])
    m.use_backface_culling = backface
    MATS[name] = m
    return m


# ★색 규칙 (탑다운에서 길과 벽을 가르는 유일한 장치다). v67 에서 전체 명도를
#   밤에서 **봄 낮**으로 올렸다. 규칙 자체는 그대로다 — 바뀐 건 밝기 대역이다.
#   걸을 수 있는 곳 = 밝고 따뜻한 색 (흙길·연둣빛 풀·금빛 마른 풀)
#   못 가는 곳     = 어둡고 차가운 색 (회청색 바위 / 진한 암록 덤불)
#   숨는 수풀      = 그 사이의 **진한 신록**. 초원보다 어둡고 훨씬 초록이라 덩어리로 읽힌다
#   폐허(사람 흔적) = 창백한 회백색. 자연물 중에 하나도 없는 색이라 랜드마크로 튄다
M_ROCK = mat_solid("MAT_ROCK", "8a9199")            # 바위 무더기(낮 화강암)
M_ROCK_DARK = mat_solid("MAT_ROCK_DARK", "6e7883")  # 외곽 절벽. 안쪽 바위보다 한 단 눌러 경계를 박는다
M_EARTH = mat_solid("MAT_EARTH", "8a6f4c")          # 흙 둔덕
M_MOSS = mat_solid("MAT_MOSS", "6f9a45")            # 이끼
M_BARK = mat_solid("MAT_BARK", "6a5138")            # 나무 줄기·쓰러진 거목
M_LEAF_DARK = mat_solid("MAT_LEAF_DARK", "22391b", rough=1.0)   # 막는 초목(제일 어두운 초록)
M_CANOPY = mat_solid("MAT_CANOPY", "4a8232", rough=1.0)         # 안 막는 나뭇가지(수풀보다 어둡다)
M_BUSH = mat_solid("MAT_BUSH", "6fd143", rough=1.0, backface=False)  # ★맵에서 제일 밝은 초록. 숨는 곳은 이 색 하나뿐이다
M_STONE_PALE = mat_solid("MAT_STONE_PALE", "cfd3cd")  # 폐허 석재
M_ALTAR = mat_solid("MAT_ALTAR", "70504a")           # 마른 피 먹은 돌(보스 자리)
M_WATER = mat_solid("MAT_WATER", "5aa3bd", rough=0.20)
M_EXIT = mat_solid("MAT_EXIT", "9fdcd2")             # 탈출 표식. 맵 어디에도 안 쓰는 색
# 맵 밖 안개 능선. ★하늘빛에 가깝게 띄워 "저 너머는 아득하다"를 색 하나로 만든다.
#   backface 를 끈다. 링을 **안에서** 보기 때문에 컬링을 켜면 통째로 사라진다
M_HAZE1 = mat_solid("MAT_HAZE1", "9fb3bd", rough=1.0, backface=False)
M_HAZE2 = mat_solid("MAT_HAZE2", "bccbd3", rough=1.0, backface=False)
M_HAZE3 = mat_solid("MAT_HAZE3", "d5dfe4", rough=1.0, backface=False)
# ★v79. 물가 갈대. 숨는 수풀(6fd143)보다 확실히 어둡고 누렇다. 색이 겹치면
#   "들어가서 숨을 수 있는 곳"으로 오해한다. 갈대는 서 있기만 하는 물건이다.
M_REED = mat_solid("MAT_REED", "7d914b", rough=1.0, backface=False)
# ★v79. 경계 바깥 배후 스커트. 안쪽 절벽(6e7883)보다 한 단 밝고 푸르게 띄운다.
#   "한 겹 더 뒤"로 읽혀야 벽이 아니라 산자락이 된다.
M_SKIRT = mat_solid("MAT_SKIRT", "76858f", rough=1.0, backface=False)
M_SKIRTROCK = mat_solid("MAT_SKIRTROCK", "5d6a75", rough=1.0, backface=False)
M_SKIRTWOOD = mat_solid("MAT_SKIRTWOOD", "44713a", rough=1.0, backface=False)

# 버퍼. 이름 앞머리가 곧 규칙이다(COL_ 막는다 / BUSH_ 숨는다 / 나머지 안 막는다)
buf_floor = None                                     # 아래에서 텍스처와 함께 만든다
buf_rock = Buf("COL_ROCK", M_ROCK)
buf_cliff = Buf("COL_CLIFF", M_ROCK_DARK)
