], root=(0, -0.06, -0.05))

# 되감기를 길게(1~18) 주고 3프레임에 뻗는다. 뻗은 자세를 길게 흘린다.
WIDE_SEQ = [(1, GUARD), (7, XG1), (18, XG2),
            (21, XS), (27, XE1), (36, XE2),
