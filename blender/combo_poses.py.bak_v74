# ================================================================ 횡일섬(넓은 가로베기)
# 오너 지적 2회를 반영한 3차 설계.
#  1차: 양손으로 오른쪽->왼쪽. 사거리가 짧았다(양손이면 손이 몸 앞 0.16H 밖으로 못 나감)
#  2차: 한손 신전으로 바꿨지만 **방향이 거꾸로였다**. 오너: "팔을 쭉 뻗는 쪽이 칼을
#       잡고 있어야지. 칼도 가로로 베다 만 느낌".
#       맞다 — 오른손이 몸을 가로질러 왼쪽으로 가면 팔이 접힐 수밖에 없다.
#       오른팔이 완전히 펴지는 방향은 **오른쪽**이다.
#  3차: 왼쪽에서 감았다가 오른쪽으로 뻗으며 벤다. 팔이 곧게 펴진다.
#  4차(현재): 오너 "진짜 가로로만 베면 어떻게. 살짝 올라가며 베야지. 왼쪽 아래에서
#       우측 위로 베는 느낌(오른손잡이 기준)". 逆袈裟(역게사) — 몸을 낮췄다가
#       **일어나면서** 벤다. 순수 수평은 힘이 안 실리고, 올려베야 체중이 실린다.
#       칼끝이 왼쪽 아래(u -0.23)에서 오른쪽 위(u +0.31)로, 약 25도 올라간다.

XG1 = P([                                   # 준비: 무릎 낮추고 칼을 왼쪽으로 넘긴다
    ("spine", X, 10), ("spine", Z, 12),
    ("r", IK, (0.01, 0.17, 0.31)),
    ("r hand", BLADE, (-0.42, -0.16, 0.89)),
    ("l", GRIP, GB),
    ("l thigh", Z, 10), ("r thigh", Z, 10),
    ("l thigh", X, 14), ("r thigh", X, -16),
    ("l calf", X, -8), ("r calf", X, 12),
], root=(0, 0.02, -0.04))

XG2 = P([                                   # 되감기: 왼쪽 끝까지 감는다. 팔은 접히지만
    ("pelvis", Z, 26), ("spine", X, 6), ("spine", Z, 30),   # 그게 스프링을 감는 것
    ("r clavicle", Y, 4), ("r clavicle", Z, -16),
    ("r", IK, (-0.01, 0.24, 0.16)),
    ("r hand", BLADE, (-0.70, -0.50, 0.51)),  # 칼끝 왼쪽 "아래". 여기서부터 올려 벤다
    ("l", GRIP, GB),                         # 몸 앞이라 양손 유지된다
    ("head", Z, -20),      # 몸통이 +56 도 감긴다. 머리까지 같이 돌리면
                            # 시선이 84 도나 돌아가 상대를 놓친다. 반대로 건다
    ("l thigh", X, 24), ("r thigh", X, -28),
    ("l calf", X, -14), ("r calf", X, 26),
], root=(0, 0.05, -0.11), wind=True)

XS = P([                                    # 일섬: 왼손을 놓고 오른팔을 오른쪽으로 쭉
    ("pelvis", Z, -18), ("spine", X, 12), ("spine", Z, -20),
    ("r clavicle", Y, -8), ("r clavicle", Z, 20),
    ("r", IK, (0.33, 0.16, 0.14)),           # 어깨에서 팔 길이의 99% - 완전 신전
    ("r hand", BLADE, (0.82, 0.36, 0.45)),   # 칼끝이 오른쪽 "위"로 (r +0.72, u +0.31)
    # ★뒤 성분 -0.74 는 날개처럼 뒤로 뻗어 과했다(오너 지적).
    # 한손 베기의 왼팔은 **옆-아래**로 벌어지는 게 자연스럽다. 뒤는 살짝만.
    ("l upperarm", AIM, (-0.70, -0.52, -0.18)),
    ("l forearm", AIM, (-0.78, -0.40, -0.14)),
    ("head", Z, 16), ("head", X, -12),   # 시선은 벤 쪽(오른쪽 위)
    ("l thigh", X, 18), ("r thigh", X, -20),
    ("l calf", X, -8), ("r calf", X, 16),
], root=(0, -0.16, -0.03), onehand=True)

XE1 = P([                                   # 다 뻗어 오른쪽 끝까지 흘린다(잔심)
    ("pelvis", Z, -30), ("spine", X, 10), ("spine", Z, -28),
    ("r clavicle", Y, -12), ("r clavicle", Z, 18),
    ("r", IK, (0.28, 0.20, 0.09)),   # 몸이 더 돌아가 어깨가 뒤로 빠지므로 살짝 당김
    ("r hand", BLADE, (0.88, 0.40, 0.26)),
    ("l upperarm", AIM, (-0.74, -0.46, -0.22)),
    ("l forearm", AIM, (-0.82, -0.34, -0.16)),
    ("head", Z, 26), ("head", X, -16),   # 뻗은 칼끝을 눈으로 따라간다
    ("l thigh", X, 14), ("r thigh", X, -16),
    ("l calf", X, -6), ("r calf", X, 12),
], root=(0, -0.17, -0.01), onehand=True)

XE2 = P([                                   # 칼을 세우며 왼손이 자루로 돌아온다
    ("pelvis", Z, -22), ("spine", X, 8), ("spine", Z, -18),
    ("r", IK, (0.13, 0.23, 0.22)),
    ("r hand", BLADE, (0.62, 0.36, 0.70)),
    ("l", GRIP, GB),
    ("head", Z, 16), ("head", X, -8),
    ("l thigh", X, 17), ("r thigh", X, -20),
    ("l calf", X, -9), ("r calf", X, 17),
], root=(0, -0.12, -0.04))

XR = P([                                    # 몸을 되돌리며 중단세로
    ("pelvis", Z, -8), ("spine", X, 9), ("spine", Z, -4),
    ("r", IK, (0.04, 0.18, 0.26)),
    ("r hand", BLADE, (0.24, 0.14, 0.96)),
    ("l", GRIP, GB),
